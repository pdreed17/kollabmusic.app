  collapsedTrackName: {
    ...Typography.bodyLarge,
    color: Colors.text,
    fontWeight: '600',
    flex: 1,
    marginRight: Spacing.sm,
  },
  collapsedTime: {
    ...Typography.body,
    color: Colors.textSecondary,
    fontVariant: ['tabular-nums'],
  },
  // EXPANDED STATE STYLES
  collapseButtonTop: {
    alignSelf: 'center',
    paddingVertical: Spacing.xs,
    paddingHorizontal: Spacing.xl,
  },
  timelineContainer: {
    paddingHorizontal: Spacing.lg,
    paddingTop: Spacing.sm,
    paddingBottom: Spacing.sm,
  },
  transportExpanded: {
    flexDirection: 'row',
    justifyContent: 'center',
    alignItems: 'center',
    gap: Spacing.md,
    paddingHorizontal: Spacing.lg,
    paddingVertical: Spacing.md,
  },
  // Focused Track Section Styles
  focusedTrackSection: {
    paddingHorizontal: Spacing.lg,
    paddingVertical: Spacing.lg,
    borderBottomWidth: 1,
    borderBottomColor: Colors.border,
  },
  focusedTrackDisplay: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: Spacing.md,
  },
  focusedTrackColor: {
    width: 6,
    height: 48,
    borderRadius: 3,
  },
  focusedTrackInfo: {
    flex: 1,
  },
  focusedTrackName: {
    ...Typography.h3,
    color: Colors.text,
    fontWeight: '700',
    marginBottom: Spacing.xxs,
  },
  focusedTrackType: {
    ...Typography.body,
    color: Colors.textSecondary,
    textTransform: 'capitalize',
    fontWeight: '500',
  },
  focusedTrackEditButton: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: Spacing.xs,
    paddingHorizontal: Spacing.md,
    paddingVertical: Spacing.sm,
    backgroundColor: Colors.surfaceElevated,
    borderRadius: BorderRadius.md,
    borderWidth: 1,
    borderColor: Colors.primary,
  },
  focusedTrackEditButtonText: {
    ...Typography.bodyLarge,
    color: Colors.primary,
    fontWeight: '600',
  },
  // Focused Track Edit Mode Styles
  focusedTrackEdit: {
    gap: Spacing.md,
  },
  focusedTrackEditTitle: {
    ...Typography.h3,
    color: Colors.text,
    fontWeight: '700',
    marginBottom: Spacing.xs,
  },
  focusedTrackNameEdit: {
    gap: Spacing.xs,
  },
  focusedTrackTypeEdit: {
    gap: Spacing.xs,
  },
  focusedTrackLabel: {
    ...Typography.body,
    color: Colors.textSecondary,
    fontWeight: '600',
    textTransform: 'uppercase',
    fontSize: 12,
    letterSpacing: 0.5,
  },
  focusedTrackInput: {
    ...Typography.bodyLarge,
    color: Colors.text,
    fontWeight: '600',
    backgroundColor: Colors.surfaceElevated,
    borderWidth: 2,
    borderColor: Colors.primary,
    borderRadius: BorderRadius.md,
    paddingHorizontal: Spacing.md,
    paddingVertical: Spacing.md,
  },
  focusedTypePickerScroll: {
    marginTop: Spacing.xs,
  },
  focusedTypeChip: {
    paddingHorizontal: Spacing.lg,
    paddingVertical: Spacing.sm,
    borderRadius: BorderRadius.md,
    backgroundColor: Colors.surfaceElevated,
    borderWidth: 2,
    borderColor: Colors.border,
    marginRight: Spacing.sm,
  },
  focusedTypeChipActive: {
    backgroundColor: Colors.primary,
    borderColor: Colors.primary,
  },
  focusedTypeChipText: {
    ...Typography.bodyLarge,
    color: Colors.textSecondary,
    fontWeight: '600',
  },
  focusedTypeChipTextActive: {
    color: Colors.text,
  },
  focusedTrackEditButtons: {
    flexDirection: 'row',
    gap: Spacing.md,
    marginTop: Spacing.sm,
  },
  focusedCancelButton: {
    flex: 1,
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'center',
    gap: Spacing.xs,
    paddingVertical: Spacing.md,
    backgroundColor: Colors.surfaceElevated,
    borderRadius: BorderRadius.md,
    borderWidth: 2,
    borderColor: Colors.border,
  },
  focusedCancelButtonText: {
    ...Typography.bodyLarge,
    color: Colors.text,
    fontWeight: '600',
  },
  focusedSaveButton: {
    flex: 1,
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'center',
    gap: Spacing.xs,
    paddingVertical: Spacing.md,
    backgroundColor: Colors.success,
    borderRadius: BorderRadius.md,
    borderWidth: 2,
    borderColor: Colors.success,
  },
  focusedSaveButtonText: {
    ...Typography.bodyLarge,
    color: '#FFF',
    fontWeight: '600',
  },
  timelineHeader: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    marginBottom: Spacing.xs,
  },
  timelineTime: {
    ...Typography.caption,
    color: Colors.textSecondary,
    fontVariant: ['tabular-nums'],
  },
  timelineSlider: {
    width: '100%',
    height: 40,
  },
  timelineComments: {
    height: 20,
    position: 'relative',
    marginTop: Spacing.xs,
  },
  commentMarker: {
    position: 'absolute',
    top: 0,
    width: 24,
    height: 24,
    justifyContent: 'center',
    alignItems: 'center',
    backgroundColor: Colors.surface,
    borderRadius: 12,
    borderWidth: 1,
    borderColor: Colors.primary,
  },
  commentInputSection: {
    backgroundColor: Colors.surface,
    borderBottomWidth: 1,
    borderBottomColor: Colors.border,
    padding: Spacing.md,
  },
  commentInputHeader: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: Spacing.xs,
    marginBottom: Spacing.sm,
  },
  commentInputTitle: {
    ...Typography.bodyLarge,
    color: Colors.text,
    fontWeight: '600',
  },
  commentTextInput: {
    backgroundColor: Colors.surfaceElevated,
    borderWidth: 1,
    borderColor: Colors.border,
    borderRadius: BorderRadius.md,
    padding: Spacing.md,
    color: Colors.text,
    ...Typography.body,
    minHeight: 80,
    textAlignVertical: 'top',
    marginBottom: Spacing.md,
  },
  commentInputButtons: {
    flexDirection: 'row',
    gap: Spacing.sm,
  },
  commentCancelButton: {
    flex: 1,
    backgroundColor: Colors.surfaceElevated,
    paddingVertical: Spacing.md,
    borderRadius: BorderRadius.md,
    alignItems: 'center',
    borderWidth: 1,
    borderColor: Colors.border,
  },
