import { supabase } from '../lib/supabase'
import * as FileSystem from 'expo-file-system'

export interface UploadAudioData {
  projectId: string
  fileName: string
  fileUri: string
  fileSize: number
  stemType?: string
  stemName?: string
}

class AudioService {
  async uploadAudioFile(
    data: UploadAudioData,
    userId: string,
    onProgress?: (progress: number) => void
  ): Promise<{ audioFile: any | null; error: Error | null }> {
    try {
      // Get file extension
      const fileExt = data.fileName.split('.').pop()?.toLowerCase()
      
      // Validate audio format
      const validFormats = ['wav', 'mp3', 'flac', 'aiff', 'midi', 'mid', 'ogg']
      if (!fileExt || !validFormats.includes(fileExt)) {
        throw new Error('Invalid audio format. Supported: WAV, MP3, FLAC, AIFF, MIDI, OGG')
      }

      // Generate unique file ID
      const fileId = `${Date.now()}_${Math.random().toString(36).substring(7)}`
      const storagePath = `${data.projectId}/stems/${fileId}.${fileExt}`

      // Read file as base64
     const base64 = await FileSystem.readAsStringAsync(data.fileUri, {
  encoding: 'base64',  // ✅ Correct - use string literal
})

      // Convert base64 to blob
      const byteCharacters = atob(base64)
      const byteNumbers = new Array(byteCharacters.length)
      for (let i = 0; i < byteCharacters.length; i++) {
        byteNumbers[i] = byteCharacters.charCodeAt(i)
      }
      const byteArray = new Uint8Array(byteNumbers)
      const blob = new Blob([byteArray], { type: this.getMimeType(fileExt) })

      // Upload to Supabase Storage
      const { error: uploadError } = await supabase.storage
        .from('audio-files')
        .upload(storagePath, blob, {
          contentType: this.getMimeType(fileExt),
          upsert: false,
        })

      if (uploadError) throw uploadError

      // Create database record
      const { data: audioFile, error: dbError } = await supabase
        .from('audio_files')
        .insert({
          project_id: data.projectId,
          file_path: storagePath,
          file_name: data.fileName,
          file_size: data.fileSize,
          file_type: fileExt === 'mid' || fileExt === 'midi' ? 'midi' : 'audio',
          format: fileExt,
          stem_type: data.stemType || 'other',
          stem_name: data.stemName || data.fileName,
          created_by: userId,
        })
        .select()
        .single()

      if (dbError) throw dbError

      return { audioFile, error: null }
    } catch (error) {
      return { audioFile: null, error: error as Error }
    }
  }

  async getProjectAudioFiles(projectId: string): Promise<{
    audioFiles: any[]
    error: Error | null
  }> {
    try {
      const { data, error } = await supabase
        .from('audio_files')
        .select('*')
        .eq('project_id', projectId)
        .order('created_at', { ascending: false })

      if (error) throw error

      return { audioFiles: data || [], error: null }
    } catch (error) {
      return { audioFiles: [], error: error as Error }
    }
  }

  async deleteAudioFile(fileId: string, filePath: string): Promise<{ error: Error | null }> {
    try {
      // Delete from storage
      const { error: storageError } = await supabase.storage
        .from('audio-files')
        .remove([filePath])

      if (storageError) throw storageError

      // Delete from database
      const { error: dbError } = await supabase
        .from('audio_files')
        .delete()
        .eq('id', fileId)

      if (dbError) throw dbError

      return { error: null }
    } catch (error) {
      return { error: error as Error }
    }
  }

  async getAudioFileUrl(filePath: string): Promise<string | null> {
    try {
      const { data } = await supabase.storage
        .from('audio-files')
        .createSignedUrl(filePath, 3600) // 1 hour expiry

      return data?.signedUrl || null
    } catch (error) {
      console.error('Error getting audio URL:', error)
      return null
    }
  }

  private getMimeType(extension: string): string {
    const mimeTypes: Record<string, string> = {
      wav: 'audio/wav',
      mp3: 'audio/mpeg',
      flac: 'audio/flac',
      aiff: 'audio/aiff',
      midi: 'audio/midi',
      mid: 'audio/midi',
      ogg: 'audio/ogg',
    }
    return mimeTypes[extension] || 'application/octet-stream'
  }
}

export const audioService = new AudioService()